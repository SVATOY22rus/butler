# Butler — конфигурация
# Скопируй этот файл в butler.env и измени значения

# ─────────────────────────────────────────────
# Основное
# ─────────────────────────────────────────────

# Секретный ключ сессий Flask (ОБЯЗАТЕЛЬНО смени на случайную строку!)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
BUTLER_SECRET_KEY=change-me-to-a-long-random-secret

# Путь к базе данных SQLite
# Оставь пустым — install.sh подставит правильный путь автоматически
BUTLER_DATABASE=

# Адрес и порт веб-интерфейса
BUTLER_HOST=0.0.0.0
BUTLER_PORT=5050

# Логин и пароль администратора
BUTLER_ADMIN_USER=admin
BUTLER_ADMIN_PASS=change-me-now

# ─────────────────────────────────────────────
# Firewall backend
# ─────────────────────────────────────────────

# Выбор бэкенда брандмауэра:
#   nftables  — (по умолчанию) классическая nftables-интеграция
#   ufw       — UFW-бэкенд (требует: sudo apt install ufw)
BUTLER_BACKEND=nftables

# ─────────────────────────────────────────────
# nftables-специфичные пути
# (игнорируются, если BUTLER_BACKEND=ufw)
# ─────────────────────────────────────────────

BUTLER_FIREWALL_TARGET=/etc/nftables.d/butler.nft
BUTLER_NFTABLES_CONF=/etc/nftables.conf
